{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/fukugyo-c-jobs/**)",
      "Edit(~/fukugyo-c-jobs/**)",
      "Read(~/Downloads/**)",
      "Edit(~/Downloads/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_customer_data.py\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "env": {
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  }
}
