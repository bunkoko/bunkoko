// このファイルを Local.xcconfig という名前でコピーして、値を書き換える（Local.xcconfig は Git に含めない）

// Apple Developer のチーム ID（10文字の英数字）
DEVELOPMENT_TEAM = ABCDE12345
// アプリの ID。世界で1つになるように、自分の名前などを入れる（例: com.taro.kenkokanri）
APP_BUNDLE_ID = com.yourname.kenkokanri
// 無料の Apple ID のあいだは Free。Apple Developer Program に登録したら Paid に変える
KENKO_EDITION = Free
