#!/bin/bash
# よく使う作業をまとめたコマンド。仮想環境 .venv の Python で動く（activate は不要）。
#   ./cfd help で一覧
set -euo pipefail
cd "$(dirname "$0")"
PY=.venv/bin/python

need_venv() { [ -x "$PY" ] || { echo "仮想環境が無い。先に ./cfd setup を実行する"; exit 1; }; }
latest_run() { ls -1d output/train/2*/ 2>/dev/null | sort | tail -1 | sed 's:/$::' || true; }
need_run() {
  RUN="$(latest_run)"
  [ -n "$RUN" ] || { echo "学習結果が無い。先に ./cfd train を実行する"; exit 1; }
  echo "学習結果: $RUN"
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  setup)  exec scripts/setup_mac.sh "$@" ;;
  update) git pull --ff-only
          # 取得したばかりの新しい cfd で続きを行う（動いている古い cfd のままだと、新しく増えた手順が抜ける）
          exec ./cfd _after_update ;;
  _after_update)
          need_venv
          # news（埋め込みの部品 sentence-transformers・PyTorch）も入れる。平日 13:05 の自動実行の「情報収集」が使う
          # （2026-10-21 に別の作業で部品が消え、update では戻らず、10-22〜10-28 の自動実行が止まった）
          UV_PYTHON_INSTALL_DIR="$PWD/.python" uv pip install --python "$PY" -e ".[dev,research,news]" -q
          "$PY" -c "import sentence_transformers, torch, sklearn, yfinance, shap" 2>/dev/null \
            || echo "⚠ 毎日の自動実行に要る部品が入っていない（上のエラーを Claude に貼る）"
          "$PY" scripts/mt5_files.py install
          echo "更新した。MT5 の MetaEditor で CfdCommodityEA と CfdExportBars をコンパイルし直す（F7）" ;;
  where)  need_venv; exec "$PY" scripts/mt5_files.py where "$@" ;;
  mt5)    need_venv; exec "$PY" scripts/mt5_files.py install "$@" ;;
  data)   need_venv
          "$PY" scripts/mt5_files.py fetch-data "$@"
          exec "$PY" scripts/check_data.py --write-instruments config/instruments_measured.json --set-config ;;
  check)  need_venv; exec "$PY" scripts/check_data.py "$@" ;;
  train)  need_venv; exec "$PY" scripts/train.py "$@" ;;
  ea)     need_venv; need_run
          rm -f output/live/current        # 以降の replay は学習結果の構成を使う
          exec "$PY" scripts/mt5_files.py install --run "$RUN" "$@" ;;
  risk)   need_venv; exec "$PY" scripts/set_risk.py --risk "$@" ;;
  preset) need_venv
          [ $# -ge 1 ] || { echo "使い方: ./cfd preset config/baselines/turtle55_d1.json [--risk-scale 0.5]"; exit 1; }
          CONF="$1"; shift
          OUT="output/live/$(basename "$CONF" .json)"
          "$PY" scripts/make_ea.py --final "$CONF" --out "$OUT"
          echo "$OUT" > output/live/current  # 以降の replay はこの構成を使う
          exec "$PY" scripts/mt5_files.py install --run "$OUT" "$@" ;;
  table)  need_venv; exec "$PY" scripts/risk_table.py "$@" ;;
  compare) need_venv
          [ $# -ge 1 ] || { echo "使い方: ./cfd compare output/live/turtle55_d1/final.json [--clean / --clean-wrong]"; exit 1; }
          exec "$PY" scripts/compare_all.py --final "$@" ;;
  logs)   need_venv; exec "$PY" scripts/mt5_files.py fetch-logs "$@" ;;
  context) need_venv; exec "$PY" scripts/fetch_context.py "$@" ;;
  study)  need_venv; exec "$PY" scripts/feature_study.py "$@" ;;
  meta)   need_venv; exec "$PY" scripts/meta_study.py "$@" ;;
  universe) need_venv; exec "$PY" scripts/universe_study.py "$@" ;;
  crypto) need_venv; exec "$PY" scripts/crypto_study.py "$@" ;;
  trend)  need_venv; exec "$PY" scripts/trend_study.py "$@" ;;
  spread) need_venv; exec "$PY" scripts/spread_study.py "$@" ;;
  diversify) need_venv; exec "$PY" scripts/diversified_study.py "$@" ;;
  carry)  need_venv; exec "$PY" scripts/carry_study.py "$@" ;;
  costnow) need_venv; exec "$PY" scripts/costnow_study.py "$@" ;;
  partner) need_venv; exec "$PY" scripts/partner_study.py "$@" ;;
  jquants) need_venv; exec "$PY" scripts/jquants.py "$@" ;;
  edinet) need_venv; exec "$PY" scripts/edinet.py "$@" ;;
  edgar)  need_venv; exec "$PY" scripts/edgar.py "$@" ;;
  overnight) need_venv; exec "$PY" scripts/overnight_study.py "$@" ;;
  stockpick) need_venv; exec "$PY" scripts/stockpick_study.py "$@" ;;
  timing) need_venv; exec "$PY" scripts/timing_study.py "$@" ;;
  stocks) need_venv; exec "$PY" scripts/stocks_study.py "$@" ;;
  shortterm) need_venv; exec "$PY" scripts/stocks_short_study.py "$@" ;;
  agents) need_venv; exec "$PY" scripts/agents.py "$@" ;;
  ml)     need_venv; exec "$PY" scripts/ml_study.py "$@" ;;
  leadlag) need_venv; exec "$PY" scripts/leadlag_study.py "$@" ;;
  intraday) need_venv; exec "$PY" scripts/intraday_study.py "$@" ;;
  news)   need_venv; exec "$PY" scripts/news_study.py "$@" ;;
  replay) need_venv
          if [ -f output/live/current ]; then
            FINAL="$(cat output/live/current)/final.json"
            echo "構成: ${FINAL}（./cfd preset で最後に MT5 に置いたもの）"
          else
            need_run; FINAL="$RUN/final.json"
          fi
          exec "$PY" scripts/replay.py --final "$FINAL" "$@" ;;
  demo-check) need_venv
          if [ -f output/live/current ]; then
            FINAL="$(cat output/live/current)/final.json"
            echo "構成: ${FINAL}（./cfd preset で最後に MT5 に置いたもの）"
          else
            need_run; FINAL="$RUN/final.json"
          fi
          exec "$PY" scripts/demo_check.py --final "$FINAL" "$@" ;;
  py)     need_venv; exec "$PY" "$@" ;;
  help|*) cat <<'HELP'
使い方: ./cfd <コマンド>

  setup    初回準備（uv・仮想環境・パッケージ・テスト・動作確認）。何度実行してもよい
  update   最新版を取得して入れ直す（EA も MT5 に置き直す）
  where    MT5 のフォルダを表示
  mt5      EA とスクリプトを MT5 に置く（MetaEditor でコンパイルする）
  data     MT5 の書き出しを取り込み → 点検 → 銘柄仕様を作って設定に反映
  check    データの点検だけ
  train    学習（結果は output/train/<日時>/report.md）
  ea       最新の学習結果からプリセットを作って MT5 に置く（--risk-scale 0.5 など）
  risk     1回の損失（と資金）を保存（例: ./cfd risk 0.015 --equity 1000000）
  preset   決めた構成からプリセットを作って MT5 に置く（例: ./cfd preset config/baselines/turtle55_d1.json）
  table    資金と 1回の損失ごとの成績の表（例: ./cfd table --final ... --start 2021-06-01）
  logs     テスターのシグナル記録を取り込む
  compare  テスターの記録を取り込み、全銘柄で EA と Python を突き合わせる（例: ./cfd compare output/live/turtle55_d1/final.json）
  replay   MT5 に置いた構成（preset か ea で最後に置いたもの）で期間を再現（--start 2026-11-01 など）
  demo-check デモ（本番）の EA のログと Python を 1 日ずつ照らし合わせる（--start 2026-10-06 --equity 10000000）
  context  外部データ（金利・ドル・株価・他の商品・投機筋の建玉）を取得し、MT5 にある関連銘柄も表示
  study    外部データで絞り込むと成績が良くなるかを検証（./cfd context の後。5 分前後）
  meta     2 次モデル（メタラベリング）で取引を選ぶと成績が良くなるかを検証（./cfd context の後。数分）
  universe 売買の対象を FX・株価指数・国債・個別株・暗号資産に広げたら良くなるかを検証（初回は --fetch。数分）
  crypto   暗号資産: check（手数料の確かめ直し）・paper（記録だけの売買）・live（少額の本番。既定は空運転）・schedule（毎朝の登録）・extra（他の通貨の過去の検証。docs/crypto.md 9 章）
  trend    トレンドフォローの改良（複数の期間・量の管理・出口）を 3 期間で確かめる（docs/trend.md。数分）
  spread   2 つの差の戻り（WTI−ブレント・金÷銀）を確かめる（docs/spread.md。数分）
  diversify 市場を分散した論文どおりのトレンドフォローを確かめる（docs/diversified.md。数分）
  carry    キャリー（原油の期間構造）を確かめる（docs/carry.md。--fetch で EIA から取る。Mac で。--paper で記録だけの売買）
  costnow  今のスプレッドで計算し直す（既定は銀。docs/costnow.md。./cfd context の先物の日足も使う。数分）
  partner  相方の行き過ぎフィルタを、使っていない商品の 5 組で確かめる（docs/cross_asset.md 7 章。Yahoo から取る。Mac で数十分）
  jquants  J-Quants の無料プランで、過去の上場銘柄一覧に後で消えた会社が入るかなどを確かめる（key でキーを保存 → check。docs/survivorship.md）
  edinet   EDINET の有報の本文で文章の信号を確かめる（key → check → fetch → momentum・lazy。docs/text_signals.md）
  edgar    米国の 10-K のリスク要因（案 2-US）。まず universe（点検 1: 時点ごとの S&P500 と値段。docs/us_text.md）
  overnight 夜だけ持つ（1306 を引けで買い翌朝の寄りで売る）の記録だけの売買の途中経過（docs/overnight.md。お金は動かさない）
  stockpick 個別株をルールで選ぶ検証（--market jp: docs/stockpick.md、--market us: docs/us_equity.md。--fetch で Yahoo から。数分）
  timing   S&P500 を持ち方で上回れるか（変動で量・10 か月平均。docs/us_equity.md。--fetch で ^GSPC）
  stocks   上がりやすい株を探す（時期・時間帯・業種・会社の 17 の仮説。docs/stocks.md。初回は --fetch で 20〜40 分）
  shortterm 株の短期の売買（一晩〜5 日）をルール・機械学習・ニュース・強化学習で確かめる（docs/stocks_short.md。stocks --fetch の後。10〜20 分）
  agents   株を 5 つの AI（情報収集・IR 評価・銘柄選定・判断・判断の評価）で扱う（docs/agents.md。collect --backfill → run。status で様子。
           earnings = 決算の数字で評価、extra = 出来高・割安さ・進捗率などを足して確かめる、
           check = 台帳の点検（自動実行・抜けた日）と先のデータの途中経過・止める決まり。docs/agents.md 12 章、
           orders = 日本株の予行演習の今日の注文の一覧（注文は出さない。平日 13:05 の run が作って iPhone に知らせる）・--fill で約定・
           --report で様子・--notify-test で知らせの試し。docs/stocks_live.md・docs/stocks_live_daily.md、
           manual = 今週の手で買う候補（M2 を週 1 回・10 銘柄・1 日遅れにした形。--test で過去の検証。docs/agents.md 13 章）、
           premium = 決算発表をまたいで持つ（J7）の先の記録（--test で過去の検証。docs/earnings_premium.md）、
           shap = M2 と決算の数字の IR 評価 AI（E2）の SHAP 値・bee swarm の図（見るためだけ。数分。docs/agents.md 14 章）
  ml       59 市場をまとめて学ぶ機械学習でポジションを決めると良くなるかを検証（universe の後。10〜40 分）
  leadlag  先行指標（原油・為替・金利など）で日米の業種・個別株を予測できるかを検証（初回は --fetch。30〜60 分）
  intraday 5 分足〜1 時間足の短い売買を、小さいコストで候補探し → 実際のコストで確認（--source mt5 で data/ の M5）
  news     ニュースを集めて埋め込み、売買に役立つかを検証（setup → compare でモデルを決め、schedule → backfill → report。
           volcheck = geo_vol を使っていない市場（S&P500・TOPIX・BTC）で。docs/text_signals.md 5 章）
  py       仮想環境の Python で実行（例: ./cfd py scripts/compare_signals.py ...）
HELP
          ;;
esac
