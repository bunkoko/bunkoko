#!/bin/bash
# よく使う作業をまとめたコマンド。仮想環境 .venv の Python で動く（activate は不要）。
#   ./cfd help で一覧
set -euo pipefail
cd "$(dirname "$0")"
PY=.venv/bin/python

need_venv() { [ -x "$PY" ] || { echo "仮想環境が無い。先に ./cfd setup を実行する"; exit 1; }; }
latest_run() { ls -1d output/train/2*/ 2>/dev/null | sort | tail -1 | sed 's:/$::' || true; }
need_run() {
  RUN="$(latest_run)"
  [ -n "$RUN" ] || { echo "学習結果が無い。先に ./cfd train を実行する"; exit 1; }
  echo "学習結果: $RUN"
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  setup)  exec scripts/setup_mac.sh "$@" ;;
  update) git pull --ff-only
          # 取得したばかりの新しい cfd で続きを行う（動いている古い cfd のままだと、新しく増えた手順が抜ける）
          exec ./cfd _after_update ;;
  _after_update)
          need_venv
          UV_PYTHON_INSTALL_DIR="$PWD/.python" uv pip install --python "$PY" -e ".[dev,research]" -q
          "$PY" scripts/mt5_files.py install
          echo "更新した。MT5 の MetaEditor で CfdCommodityEA と CfdExportBars をコンパイルし直す（F7）" ;;
  where)  need_venv; exec "$PY" scripts/mt5_files.py where "$@" ;;
  mt5)    need_venv; exec "$PY" scripts/mt5_files.py install "$@" ;;
  data)   need_venv
          "$PY" scripts/mt5_files.py fetch-data "$@"
          exec "$PY" scripts/check_data.py --write-instruments config/instruments_measured.json --set-config ;;
  check)  need_venv; exec "$PY" scripts/check_data.py "$@" ;;
  train)  need_venv; exec "$PY" scripts/train.py "$@" ;;
  ea)     need_venv; need_run
          rm -f output/live/current        # 以降の replay は学習結果の構成を使う
          exec "$PY" scripts/mt5_files.py install --run "$RUN" "$@" ;;
  risk)   need_venv; exec "$PY" scripts/set_risk.py --risk "$@" ;;
  preset) need_venv
          [ $# -ge 1 ] || { echo "使い方: ./cfd preset config/baselines/turtle55_d1.json [--risk-scale 0.5]"; exit 1; }
          CONF="$1"; shift
          OUT="output/live/$(basename "$CONF" .json)"
          "$PY" scripts/make_ea.py --final "$CONF" --out "$OUT"
          echo "$OUT" > output/live/current  # 以降の replay はこの構成を使う
          exec "$PY" scripts/mt5_files.py install --run "$OUT" "$@" ;;
  table)  need_venv; exec "$PY" scripts/risk_table.py "$@" ;;
  compare) need_venv
          [ $# -ge 1 ] || { echo "使い方: ./cfd compare output/live/turtle55_d1/final.json [--clean / --clean-wrong]"; exit 1; }
          exec "$PY" scripts/compare_all.py --final "$@" ;;
  logs)   need_venv; exec "$PY" scripts/mt5_files.py fetch-logs "$@" ;;
  context) need_venv; exec "$PY" scripts/fetch_context.py "$@" ;;
  study)  need_venv; exec "$PY" scripts/feature_study.py "$@" ;;
  meta)   need_venv; exec "$PY" scripts/meta_study.py "$@" ;;
  universe) need_venv; exec "$PY" scripts/universe_study.py "$@" ;;
  ml)     need_venv; exec "$PY" scripts/ml_study.py "$@" ;;
  replay) need_venv
          if [ -f output/live/current ]; then
            FINAL="$(cat output/live/current)/final.json"
            echo "構成: $FINAL（./cfd preset で最後に MT5 に置いたもの）"
          else
            need_run; FINAL="$RUN/final.json"
          fi
          exec "$PY" scripts/replay.py --final "$FINAL" "$@" ;;
  py)     need_venv; exec "$PY" "$@" ;;
  help|*) cat <<'HELP'
使い方: ./cfd <コマンド>

  setup    初回準備（uv・仮想環境・パッケージ・テスト・動作確認）。何度実行してもよい
  update   最新版を取得して入れ直す（EA も MT5 に置き直す）
  where    MT5 のフォルダを表示
  mt5      EA とスクリプトを MT5 に置く（MetaEditor でコンパイルする）
  data     MT5 の書き出しを取り込み → 点検 → 銘柄仕様を作って設定に反映
  check    データの点検だけ
  train    学習（結果は output/train/<日時>/report.md）
  ea       最新の学習結果からプリセットを作って MT5 に置く（--risk-scale 0.5 など）
  risk     1回の損失（と資金）を保存（例: ./cfd risk 0.015 --equity 1000000）
  preset   決めた構成からプリセットを作って MT5 に置く（例: ./cfd preset config/baselines/turtle55_d1.json）
  table    資金と 1回の損失ごとの成績の表（例: ./cfd table --final ... --start 2021-06-01）
  logs     テスターのシグナル記録を取り込む
  compare  テスターの記録を取り込み、全銘柄で EA と Python を突き合わせる（例: ./cfd compare output/live/turtle55_d1/final.json）
  replay   MT5 に置いた構成（preset か ea で最後に置いたもの）で期間を再現（--start 2026-11-01 など）
  context  外部データ（金利・ドル・株価・他の商品・投機筋の建玉）を取得し、MT5 にある関連銘柄も表示
  study    外部データで絞り込むと成績が良くなるかを検証（./cfd context の後。5 分前後）
  meta     2 次モデル（メタラベリング）で取引を選ぶと成績が良くなるかを検証（./cfd context の後。数分）
  universe 売買の対象を FX・株価指数・国債・個別株・暗号資産に広げたら良くなるかを検証（初回は --fetch。数分）
  ml       59 市場をまとめて学ぶ機械学習でポジションを決めると良くなるかを検証（universe の後。10〜40 分）
  py       仮想環境の Python で実行（例: ./cfd py scripts/compare_signals.py ...）
HELP
          ;;
esac
